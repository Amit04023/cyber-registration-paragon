<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>Security Awareness</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      height: 100vh;
      font-family: Arial, sans-serif;
      background: #05070b;
      color: #e5e7eb;
      overflow: hidden;
    }

    .bg-animate {
      position: fixed;
      inset: 0;
      background: linear-gradient(120deg, #001f1a, #001a2e, #002a24, #001f1a);
      background-size: 300% 300%;
      animation: gradientMove 18s ease infinite;
      z-index: 0;
    }

    @keyframes gradientMove {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .grid {
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0,255,170,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,255,170,0.06) 1px, transparent 1px);
      background-size: 42px 42px;
      animation: gridMove 22s linear infinite;
      z-index: 1;
    }

    @keyframes gridMove {
      from { transform: translateY(0); }
      to { transform: translateY(42px); }
    }

    .glow {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 20% 25%, rgba(0,255,170,0.18), transparent 34%),
        radial-gradient(circle at 80% 75%, rgba(0,120,255,0.16), transparent 38%);
      animation: glowMove 10s ease-in-out infinite alternate;
      z-index: 2;
    }

    @keyframes glowMove {
      from { transform: translateY(0); }
      to { transform: translateY(-22px); }
    }

    .wrap {
      position: relative;
      z-index: 3;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px;
    }

    .card {
      width: 760px;
      max-width: 95%;
      background: rgba(8, 13, 22, 0.86);
      border: 1px solid rgba(0,255,170,0.28);
      border-radius: 18px;
      padding: 34px;
      box-shadow: 0 0 60px rgba(0,255,170,0.16);
      backdrop-filter: blur(10px);
    }

    .logo {
      width: 90px;
      margin-bottom: 18px;
      border-radius: 12px;
      -webkit-mask-image: radial-gradient(circle, black 65%, transparent 100%);
      mask-image: radial-gradient(circle, black 65%, transparent 100%);
    }

    .badge {
      display: inline-block;
      padding: 7px 12px;
      border: 1px solid rgba(0,255,170,0.35);
      border-radius: 999px;
      color: #00ffaa;
      font-size: 13px;
      margin-bottom: 18px;
    }

    h1 {
      margin: 0 0 14px;
      font-size: 32px;
      color: #fff;
    }

    #typed {
      min-height: 210px;
      white-space: pre-line;
      line-height: 1.9;
      font-size: 18px;
      color: #cbd5e1;
    }

    .btn {
      display: none;
      margin-top: 25px;
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 12px;
      background: #00d084;
      color: #00110a;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    .btn:hover {
      background: #00b873;
    }

    .note {
      margin-top: 18px;
      color: #94a3b8;
      font-size: 13px;
    }
  </style>
</head>

<body>

<div class="bg-animate"></div>
<div class="grid"></div>
<div class="glow"></div>

<div class="wrap">
  <div class="card">

    <img src="/logo1.png" class="logo" alt="logo">

    <div class="badge">Security Awareness Simulation</div>

    <h1>שלום <%= name %></h1>

    <div id="typed"></div>

    <button id="btn" class="btn" onclick="goToRegister()">
      הבנתי, המשך להרשמה להרצאת מודעות סייבר
    </button>

    <div class="note">
      זהו תרגיל מודעות בלבד. לא נאספו סיסמאות או פרטים רגישים.
    </div>

  </div>
</div>

<script>
  const message = `
הלחיצה על הקישור זוהתה.

זה בדיוק הרגע שבו בארגונים אמיתיים מתרחשות רוב טעויות האבטחה:
קישור שנראה מוכר.
מסמך שנראה רגיל.
הודעה שנראית תמימה.

המטרה של הסימולציה היא להזכיר:
לא פותחים קישורים בלי לבדוק מקור.
לא מזינים פרטים בלי לוודא כתובת אתר.
לא סומכים על שם או לוגו בלבד.

זו הייתה סימולציית מודעות סייבר של Paragon.
`;

  const typed = document.getElementById("typed");
  const btn = document.getElementById("btn");

  let i = 0;

  function typeText() {
    if (i < message.length) {
      typed.textContent += message.charAt(i);
      i++;
      setTimeout(typeText, 32);
    } else {
      btn.style.display = "block";
    }
  }

  function goToRegister() {
    window.location.href = "/register-page?u=<%= token %>";
  }

  typeText();
</script>

</body>
</html>