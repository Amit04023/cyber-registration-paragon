<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>Security Awareness</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body class="awareness-page">

  <!-- רקע אש חדש -->
  <div class="fire-hero">
    <img src="/logo2.png" class="fire-logo-bg" alt="logo">
    <canvas id="smokeCanvas"></canvas>
    <canvas id="embersCanvas"></canvas>
    <div class="fire-overlay"></div>
  </div>

  <!-- תוכן -->
  <div class="awareness-wrap">
    <div class="awareness-card">

      <img src="/logo1.png" class="awareness-logo" alt="logo">

      <div class="awareness-badge">
        Paragon Advanced Security Awareness Simulation
      </div>

      <h1>שלום <%= name %></h1>

      <div id="typed"></div>

      <button id="btn" class="awareness-btn" onclick="goToRegister()">
        הבנתי, המשך להרשמה להרצאת מודעות סייבר
      </button>

      <div class="awareness-note">
        זהו תרגיל מודעות בלבד. לא נאספו סיסמאות או פרטים רגישים.
      </div>

    </div>
  </div>

  <script>
    const message = `
הלחיצה על הקישור זוהתה.

זה בדיוק הרגע שבו בארגונים אמיתיים מתרחשות רוב טעויות האבטחה:
קישור שנראה מוכר.
מסמך שנראה רגיל.
הודעה שנראית תמימה.

המטרה של הסימולציה היא להזכיר:
לא פותחים קישורים בלי לבדוק מקור.
לא מזינים פרטים בלי לוודא כתובת אתר.
לא סומכים על שם או לוגו בלבד.

זו הייתה סימולציית מודעות סייבר של Paragon.
`;

    const typed = document.getElementById("typed");
    const btn = document.getElementById("btn");

    let i = 0;

    function typeText() {
      if (i < message.length) {
        typed.textContent += message.charAt(i);
        i++;
        setTimeout(typeText, 32);
      } else {
        btn.style.display = "block";
      }
    }

    function goToRegister() {
      window.location.href = "/register-page?u=<%= token %>";
    }

    typeText();
  </script>

  <script src="/script.js"></script>

</body>
</html>